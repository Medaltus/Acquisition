{
  "functions": {
    "api/setup-sheet.js": {
      "maxDuration": 60
    },
    "api/discover-brands.js": {
      "maxDuration": 300
    },
    "api/enrich-brands.js": {
      "maxDuration": 300
    },
    "api/scan-products.js": {
      "maxDuration": 300
    },
    "api/amazon-check.js": {
      "maxDuration": 300
    },
    "api/dashboard-data.js": {
      "maxDuration": 60
    },
    "api/brand-products.js": {
      "maxDuration": 60
    },
    "api/dashboard-update.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/discover-brands",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/enrich-brands",
      "schedule": "20 */2 * * *"
    },
    {
      "path": "/api/scan-products",
      "schedule": "40 */2 * * *"
    },
    {
      "path": "/api/amazon-check",
      "schedule": "50 */2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/medaltus_brands_index.html"
    }
  ]
}
